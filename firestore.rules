rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(resourceData) {
      return isSignedIn() && resourceData.ownerId == request.auth.uid;
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }
    
    function isValidPlatform(data) {
      return data.id is string
        && data.id.size() <= 128
        && data.title is string
        && data.title.size() <= 200
        && data.tags is list
        && data.projects is list
        && data.ownerId == request.auth.uid
        && (!('image' in data) || (data.image is string && data.image.size() <= 2500000));
    }

    function isValidUser(data) {
      return data.uid is string
        && data.uid.size() <= 128
        && data.email is string
        && data.email.size() <= 128
        && data.displayName is string
        && data.displayName.size() <= 200
        && data.username is string
        && data.username.size() <= 100
        && data.photoURL is string
        && data.photoURL.size() <= 2500000
        && data.provider is string
        && data.provider.size() <= 30;
    }
    
    // Users collection
    match /users/{email} {
      allow get: if true;
      allow list: if isSignedIn();
      
      allow create: if isSignedIn()
        && incoming().uid == request.auth.uid
        && isValidUser(incoming());
        
      allow update: if isSignedIn()
        && existing().uid == request.auth.uid
        && incoming().uid == request.auth.uid
        && incoming().email == existing().email
        && isValidUser(incoming());
        
      allow delete: if isSignedIn()
        && existing().uid == request.auth.uid;
    }
    
    // Platforms collection
    match /platforms/{platformId} {
      // Allow single read (including when document doesn't exist yet to check existence)
      // and queries where the owner is the current user
      allow get: if isSignedIn() && (resource == null || isOwner(existing()));
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      
      // Allow creating platforms
      allow create: if isSignedIn() 
        && isValidId(platformId)
        && isValidPlatform(incoming())
        && incoming().createdAt is string
        && incoming().createdAt.size() <= 50
        && incoming().updatedAt is string
        && incoming().updatedAt.size() <= 50;
        
      // Allow updating platforms
      allow update: if isSignedIn()
        && isOwner(existing())
        && isValidPlatform(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt is string
        && incoming().updatedAt.size() <= 50;
        
      // Allow deleting platforms
      allow delete: if isOwner(existing());
    }
  }
}
